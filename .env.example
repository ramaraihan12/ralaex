# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared secret for the Vercel cron routes under /api.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me

# Public demo only: prints the shared login on /login and hides receipt upload.
# NEXT_PUBLIC_DEMO_MODE=true
